{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shar-production-open-tools.pages.dev/evidence-records/schemas/call-sheet-acknowledgment.schema.json",
  "title": "SHAR Production Call sheet acknowledgment evidence record",
  "description": "Records receipt of a dated call sheet revision.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_id",
    "created_at",
    "project_id",
    "status",
    "call_time"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "call_time": {
      "type": "string"
    }
  }
}
