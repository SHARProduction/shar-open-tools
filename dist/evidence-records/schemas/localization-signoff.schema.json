{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shar-production-open-tools.pages.dev/evidence-records/schemas/localization-signoff.schema.json",
  "title": "SHAR Production Localization signoff evidence record",
  "description": "Records locale, reviewer and approved localization revision.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_id",
    "created_at",
    "project_id",
    "status",
    "locale"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    }
  }
}
