{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shar-production-open-tools.pages.dev/evidence-records/schemas/supplier-bid-evaluation.schema.json",
  "title": "SHAR Production Supplier bid evaluation evidence record",
  "description": "Records criteria, bid reference and review decision.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_id",
    "created_at",
    "project_id",
    "status",
    "bid_reference"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "bid_reference": {
      "type": "string"
    }
  }
}
