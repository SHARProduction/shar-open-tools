{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shar-production-open-tools.pages.dev/evidence-records/schemas/cgi-asset-provenance.schema.json",
  "title": "SHAR Production CGI asset provenance evidence record",
  "description": "Records CGI source, authoring tool and licensing reference.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_id",
    "created_at",
    "project_id",
    "status",
    "authoring_tool"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "authoring_tool": {
      "type": "string"
    }
  }
}
