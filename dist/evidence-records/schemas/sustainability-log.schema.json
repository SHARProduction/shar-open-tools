{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shar-production-open-tools.pages.dev/evidence-records/schemas/sustainability-log.schema.json",
  "title": "SHAR Production Sustainability log evidence record",
  "description": "Records measured production activity and declared unit.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_id",
    "created_at",
    "project_id",
    "status",
    "measurement_unit"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "measurement_unit": {
      "type": "string"
    }
  }
}
