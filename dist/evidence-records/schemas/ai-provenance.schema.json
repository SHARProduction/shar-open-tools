{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shar-production-open-tools.pages.dev/evidence-records/schemas/ai-provenance.schema.json",
  "title": "SHAR Production AI provenance evidence record",
  "description": "Records declared AI-assisted operation, model family and human review.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_id",
    "created_at",
    "project_id",
    "status",
    "human_reviewed"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "human_reviewed": {
      "type": "boolean"
    }
  }
}
