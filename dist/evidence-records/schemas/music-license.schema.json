{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shar-production-open-tools.pages.dev/evidence-records/schemas/music-license.schema.json",
  "title": "SHAR Production Music license evidence record",
  "description": "Records track usage rights, channels, territory and term.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_id",
    "created_at",
    "project_id",
    "status",
    "rights_end"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "rights_end": {
      "type": "string"
    }
  }
}
